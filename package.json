    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "mysql2": "^3.14.4"
  },
  "devDependencies": {
    "chai": "^5.2.1",
    "mocha": "^11.7.1",
    "mochawesome": "^7.1.4",
    "supertest": "^7.1.4"
  }
}
