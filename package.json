{
  "name": "besd-fn-023",
  "version": "1.0.0",
  "description": "Express and MySQL course enrollment registration API for student b671103023",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "test": "mocha --reporter spec --timeout 10000",
    "test:report": "mocha --reporter mochawesome --reporter-options reportDir=test-report,reportFilename=integration-tests,html=true,json=true --timeout 10000",
