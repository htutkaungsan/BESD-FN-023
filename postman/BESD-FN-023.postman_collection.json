{
  "info": {
    "name": "BESD-FN-023 User API",
    "description": "Postman verification for all implemented API routes. Targets a separate local database populated with fictional test records at http://127.0.0.1:3001.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3001"
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Health API returns 200 OK', function () { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('ok'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /users",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 for /users', function () { pm.response.to.have.status(200); });",
              "pm.test('Returns 3 users and hides passwords', function () { const users=pm.response.json(); pm.expect(users).to.be.an('array').with.length(3); users.forEach(function(user){pm.expect(user).not.to.have.property('userPassword');}); });"
            ]
          }
        }
      ]
    },
    {
      "name": "GET /user",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/user"
      },
      "event": [
