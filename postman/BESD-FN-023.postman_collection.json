            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 for /user', function () { pm.response.to.have.status(200); });",
              "pm.test('Returns 3 users and hides passwords', function () { const users=pm.response.json(); pm.expect(users).to.be.an('array').with.length(3); users.forEach(function(user){pm.expect(user).not.to.have.property('userPassword');}); });"
            ]
          }
        }
      ]
    },
