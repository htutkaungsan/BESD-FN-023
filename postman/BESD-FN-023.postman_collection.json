              "pm.test('Returns 3 users and hides passwords', function () { const users=pm.response.json(); pm.expect(users).to.be.an('array').with.length(3); users.forEach(function(user){pm.expect(user).not.to.have.property('userPassword');}); });"
            ]
          }
        }
      ]
    },
    {
      "name": "POST /users/signup",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userEmail\": \"{{postmanSignupUsers}}\",\n  \"userPassword\": \"Postman123\",\n  \"userFirstName\": \"Postman\",\n  \"userLastName\": \"Student\",\n  \"userTel\": \"0812345678\",\n  \"dateOfBirth\": \"2000-01-15\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/users/signup"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('postmanSignupUsers', 'postman.postmanSignupUsers.' + Date.now() + '@example.com');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201 for /users/signup', function () { pm.response.to.have.status(201); pm.expect(pm.response.json().message).to.eql('Created'); });"
            ]
          }
        }
      ]
    },
