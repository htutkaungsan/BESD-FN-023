    {
      "name": "IT-3 Duplicate email",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userEmail\": \"student1@example.test\",\n  \"userPassword\": \"Postman123\",\n  \"userFirstName\": \"Duplicate\",\n  \"userLastName\": \"Test\",\n  \"userTel\": \"0812345678\",\n  \"dateOfBirth\": \"2000-01-15\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Duplicate email returns 409', function () { pm.response.to.have.status(409); pm.expect(pm.response.json().error).to.match(/email already exists/i); });"
            ]
          }
        }
      ]
    },
    {
      "name": "IT-4 Incomplete registration",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userEmail\": \"incomplete@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Incomplete registration returns 400', function () { pm.response.to.have.status(400); pm.expect(pm.response.json().error).to.match(/missing mandatory fields/i); pm.expect(pm.response.json().missingFields).to.include('userPassword'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Verify all registrations and GET response",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('All 4 POST route variants registered a user', function () { pm.response.to.have.status(200); const users=pm.response.json(); pm.expect(users).to.have.length(7); const emails=['postmanSignupUsers','postmanSignupUser','postmanUser','postmanUsers'].map(function(k){return pm.collectionVariables.get(k).toLowerCase();}); emails.forEach(function(email){pm.expect(users.some(function(user){return user.userEmail===email;}),email).to.eql(true);}); users.forEach(function(user){pm.expect(user).not.to.have.property('userPassword');}); });"
            ]
          }
        }
      ]
    }
  ]
